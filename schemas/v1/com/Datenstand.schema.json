{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/conuti-gmbh/bo4e-schema/master/schemas/v1/com/Datenstand.schema.json",
  "title": "Datenstand",
  "type": "object",
  "properties": {
    "jahresverbrauchsprognose": {
      "$ref": "../com/Menge.schema.json"
    },
    "tatsaechlichBilanzierteEnergiemenge": {
      "$ref": "../com/Menge.schema.json"
    },
    "zuBilanzierendeEnergiemenge": {
      "$ref": "../com/Menge.schema.json"
    },
    "bilanzkreis": {
      "type": "string",
      "description": "Bilanzkreis"
    },
    "bilanzierungsgebiet": {
      "type": "string",
      "description": "Bilanzierungsgebiet"
    },
    "lastprofile": {
      "type": ["array", "null"],
      "items": {
        "$ref": "../com/Lastprofil.schema.json"
      },
      "description": "Eine Liste der verwendeten Lastprofile (SLP, SLP/TLP, ALP etc.)"
    },
    "aggregationsverantwortung": {
      "$ref": "../enum/Aggregationsverantwortung.schema.json",
      "description": "Aggregationsverantwortung"
    }
  }
}
