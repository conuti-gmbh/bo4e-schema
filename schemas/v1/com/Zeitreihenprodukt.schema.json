{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/conuti-gmbh/bo4e-schema/master/schemas/v1/com/Zeitreihenprodukt.schema.json",
  "title": "Zeitreihenprodukt",
  "type": "object",
  "properties": {
    "identifikation": {
      "type": "string",
      "description": "Identifikation des Zeitreihenprodukts, z.B. OBIS-Kennzahl"
    },
    "korrekturfaktor": {
      "type": "number",
      "format": "float",
      "faker": {
        "number.float": {
          "multipleOf": 0.25,
          "min": 10,
          "max": 20
        }
      },
      "description": "Gibt ggf. einen Korrekturfaktor für die Menge an."
    },
    "energiemenge": {
      "$ref": "../com/Verbrauch.schema.json",
      "description": "Energiemenge des Zeitreihenprodukts im Bezugszeitraum"
    },
    "jahresverbrauchsprognose": {
      "$ref": "../com/Menge.schema.json",
      "description": "Jahresverbrauchsprognose"
    }
  }
}
