{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/conuti-gmbh/bo4e-schema/master/schemas/v1/com/Vorauszahlung.schema.json",
  "title": "Vorauszahlung",
  "type": "object",
  "properties": {
    "wert": {
      "type": "number",
      "format": "float",
      "faker": {
        "number.float": {
          "multipleOf": 0.25,
          "min": 1,
          "max": 10
        }
      },
      "description": "Gibt den Betrag der Vorauszahlung an."
    },
    "waehrung": {
      "$ref": "../enum/Waehrungseinheit.schema.json",
      "description": "Währung der Vorauszahlung"
    },
    "referenzVorgaengerrechnung": {
      "type": "string",
      "faker": {
        "string.binary": {
          "prefix": "RN_",
          "length": 6
        }
      },
      "description": "Referenz auf die Vorgängerrechnung der Vorauszahlung"
    },
    "datumVorgaengerrechnung": {
      "type": "string",
      "format": "date-time",
      "description": "Datum der Vorgängerrechnung der Vorauszahlung"
    }
  }
}
